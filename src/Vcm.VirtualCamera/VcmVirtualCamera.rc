#include <winver.h>

// VCM_VERSION_MAJOR/MINOR/PATCH are defined by CMakeLists.txt from VCM_VERSION.
#define VCM_STR2(x) #x
#define VCM_STR(x) VCM_STR2(x)
#define VCM_VERSION_COMMA VCM_VERSION_MAJOR,VCM_VERSION_MINOR,VCM_VERSION_PATCH,0
#define VCM_VERSION_TEXT VCM_STR(VCM_VERSION_MAJOR) "." VCM_STR(VCM_VERSION_MINOR) "." VCM_STR(VCM_VERSION_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VCM_VERSION_COMMA
 PRODUCTVERSION VCM_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VCM"
            VALUE "FileDescription", "VideoConference Mute virtual camera media source"
            VALUE "FileVersion", VCM_VERSION_TEXT
            VALUE "InternalName", "VcmVirtualCamera.dll"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "VcmVirtualCamera.dll"
            VALUE "ProductName", "VideoConference Mute"
            VALUE "ProductVersion", VCM_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
